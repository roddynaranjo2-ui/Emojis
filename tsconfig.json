{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "@emojiverse/core": ["packages/core/src/index.ts"],
      "@emojiverse/content": ["packages/content/src/index.ts"],
      "@emojiverse/game": ["packages/game/src/index.ts"],
      "@emojiverse/ui": ["packages/ui/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "tools/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/android/**"]
}
